# 识图配置模板：复制为 .env 并填写
# 推荐服务：阿里云百炼（千问） https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxx
VISION_MODEL=qwen-vl-max
# AI 文生图模型（AI 生成图纸菜单用；通义万相系列）
WANX_MODEL=wanx2.1-t2i-turbo
# 如果用非千问（OpenAI 兼容）服务，改这里
# DASHSCOPE_BASE_URL=https://api.openai.com/v1

# ---------- 邮件（SMTP 找回密码）----------
# 也可在后台「系统设置 - 邮件服务」中配置（优先使用后台值）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=noreply@example.com
# SMTP_PASS=your-smtp-password-or-auth-code
# SMTP_FROM=拼豆工坊 <noreply@example.com>
# 前端地址，用于构建邮件中的重置链接
# FRONTEND_URL=http://localhost:5173
